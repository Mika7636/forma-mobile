# FORMA — environment variables.
#
# Copy to `.env` and fill in. `.gitignore` excludes the whole `.env*` family and
# allows only this file, so real values can never be committed by accident.
#
# Expo's CLI loads `.env` automatically for `npx expo …`, and
# `npm run seed:demo` reads the same file — so one set of values configures both
# the app build and the seed script, and there is nowhere for them to drift apart.

# ---------------------------------------------------------------------------
# Google Maps (Android)
# ---------------------------------------------------------------------------
# Needed for a dev/EAS build to render maps at all; Expo Go supplies its own key
# and ignores this. Without it the app shows a placeholder where the route map
# would be — including on the demo account's GPS-tracked runs. See app.config.js.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# The pre-seeded account behind the "Try Demo" button on the login screen. With
# neither of the first two set, the button is not rendered and the app behaves
# exactly as it did before demo mode existed.
#
# SECURITY: these are compiled into the APK and are readable by anyone who
# unpacks it, exactly as the Maps key above is. That is only acceptable because
# of what this account is — a throwaway identity holding synthetic training data,
# on a handset about to be passed around a room. Never point it at an account
# with anything real in it, and rotate the password afterwards.
FORMA_DEMO_EMAIL=
FORMA_DEMO_PASSWORD=

# Optional. Display name for the demo athlete (default: "Alex Rivera").
FORMA_DEMO_NAME=

# Optional. Where the demo account's generated GPS routes are drawn. Defaults to
# Hyde Park, London. Set these to somewhere local if a tester recognising the
# map matters to the pitch.
FORMA_DEMO_LAT=
FORMA_DEMO_LNG=

# Optional. Password for the supporting accounts created by
# `npm run seed:demo -- --userbase`. Defaults to FORMA_DEMO_PASSWORD.
# Their addresses are derived from FORMA_DEMO_EMAIL by plus-addressing
# (you+demo-priya@…), so they all deliver to the one real mailbox.
FORMA_DEMO_USERBASE_PASSWORD=
