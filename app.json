{
  "expo": {
    "name": "FORMA",
    "slug": "formafitnesstracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "backgroundColor": "#0B1220",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B1220"
    },
    "android": {
      "backgroundColor": "#0B1220",
      "adaptiveIcon": {
        "backgroundColor": "#F2FAF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.forma.fitnesstracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FORMA uses your location to track distance, pace and route while you record a live workout.",
          "locationAlwaysAndWhenInUsePermission": "FORMA keeps tracking your route while the screen is off so a run recorded with the phone in your pocket is complete.",
          "locationAlwaysPermission": "FORMA keeps tracking your route while the screen is off so a run recorded with the phone in your pocket is complete.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "androidForegroundServiceIcon": "./assets/android-icon-monochrome.png"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#22C55E",
          "defaultChannel": "forma-default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "57c3ef61-a70e-490d-81c4-4a044fd3716b"
      }
    },
    "owner": "banzai121"
  }
}
